{
  "manifest_version": 3,
  "name": "MealConvene Cart Fill",
  "version": "0.1.0",
  "description": "Builds your team's MealConvene order in the restaurant's own online cart, in your browser. You still check out and pay.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "MealConvene Cart Fill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.subway.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.subway.com/*"
      ],
      "js": [
        "engine.js",
        "adapters/subway.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
